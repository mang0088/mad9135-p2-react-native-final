{
  "name": "mad9135-p2-react-native-final",
  "version": "2.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.3.0",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "lucide-react-native": "^1.57.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-paper": "^5.15.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.3.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "puppeteer-core": "^25.13.0",
    "react-test-renderer": "19.2.3",
    "typescript": "~6.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "setupFiles": [
          "<rootDir>/jest.setup.js"
        ],
        "moduleNameMapper": {
          "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js",
          "^react-native-worklets$": "<rootDir>/node_modules/react-native-worklets/lib/module/mock.js"
        },
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.js"
        ]
      }
    ]
  },
  "private": true
}
