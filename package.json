{
  "name": "mad9135-p2-react-native-final",
  "version": "1.0.0",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "server": "node server/index.js",
    "test": "jest",
    "test:app": "jest --selectProjects app",
    "test:server": "jest --selectProjects server",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-navigation/bottom-tabs": "^7.20.0",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/stack": "^7.12.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "expo": "~57.0.0",
    "expo-constants": "~57.0.21",
    "expo-font": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "express": "^5.3.0",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@testing-library/react-native": "^13.3.3",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.6",
    "react-test-renderer": "19.2.3",
    "supertest": "^7.3.1",
    "typescript": "~6.0.3"
  },
  "jest": {
    "projects": [
      {
        "displayName": "app",
        "preset": "jest-expo",
        "setupFiles": [
          "<rootDir>/jest.setup.js"
        ],
        "testMatch": [
          "<rootDir>/__tests__/**/*.test.js"
        ]
      },
      {
        "displayName": "server",
        "testEnvironment": "node",
        "testMatch": [
          "<rootDir>/server/__tests__/**/*.test.js"
        ]
      }
    ]
  },
  "private": true
}
