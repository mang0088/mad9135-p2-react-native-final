# Copy this file to `.env` and fill in your real key.
#
# SERVER-SIDE ONLY.
# This key is read by the Node backend in `server/`. It must never be prefixed
# with EXPO_PUBLIC_, never committed, and never embedded in the mobile app.
GEOAPIFY_API_KEY=your_actual_key_here

# Port the backend listens on (the app defaults to 3001).
PORT=3001

# Bind address. 0.0.0.0 lets a physical device on the same Wi-Fi reach the
# backend; use 127.0.0.1 to restrict it to this machine only.
HOST=0.0.0.0
